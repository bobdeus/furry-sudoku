; Furry Sudoku — standalone, offline Godot project.
config_version=5

[application]
config/name="Furry Sudoku"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://assets/icon.svg"
config/version="1.3.0"
boot_splash/show_image=false
boot_splash/bg_color=Color(0.9725, 0.9569, 0.9333, 1)

[display]
window/size/viewport_width=720
window/size/viewport_height=1440
window/size/window_width_override=500
window/size/window_height_override=1000
window/stretch/mode="canvas_items"
window/handheld/orientation=1

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false
textures/vram_compression/import_etc2_astc=true
environment/defaults/default_clear_color=Color(0.9725, 0.9569, 0.9333, 1)

[input_devices]
pointing/emulate_mouse_from_touch=true

[audio]
driver/enable_input=false
